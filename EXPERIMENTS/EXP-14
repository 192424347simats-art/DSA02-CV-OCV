import cv2
import numpy as np

img = cv2.imread("image.jpg")

src = np.float32([[50,50], [400,50], [50,400], [400,400]])
dst = np.float32([[0,0], [400,0], [0,400], [400,400]])

H, status = cv2.findHomography(src, dst)

result = cv2.warpPerspective(img, H, (500,500))

cv2.imshow("Homography", result)
cv2.waitKey(0)
cv2.destroyAllWindows()
