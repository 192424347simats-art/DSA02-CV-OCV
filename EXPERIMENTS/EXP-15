import cv2
import numpy as np

img = cv2.imread("image.jpg")

src = np.float32([[50,50], [400,50], [50,400], [400,400]])
dst = np.float32([[0,0], [400,20], [20,400], [400,400]])

A = []

for (x,y), (X,Y) in zip(src, dst):
    A.append([-x,-y,-1,0,0,0,x*X,y*X,X])
    A.append([0,0,0,-x,-y,-1,x*Y,y*Y,Y])

A = np.array(A)

_, _, V = np.linalg.svd(A)
H = V[-1].reshape(3,3)
H = H / H[2,2]

result = cv2.warpPerspective(img, H, (500,500))

cv2.imshow("DLT", result)
cv2.waitKey(0)
cv2.destroyAllWindows()
